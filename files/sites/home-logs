# VictoriaLogs' search UI and query API. VictoriaLogs has no login of its own,
# so Cloudflare Access is the only thing deciding who gets in, and the client
# cert check below ensures requests can only arrive via Cloudflare. Only
# /select/ is proxied, which is read-only; ingestion, deletion and the admin
# endpoints stay on loopback.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name  home-logs.itsshedtime.com;

    ssl_certificate /etc/letsencrypt/live/home-logs.itsshedtime.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/home-logs.itsshedtime.com/privkey.pem;

    # Authenticated Origin Pulls, as for homeassistant
    ssl_client_certificate /etc/nginx/client-certs/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;

    location /select/ {
        proxy_pass http://127.0.0.1:9428;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Live tailing streams its response
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = / {
        return 302 /select/vmui/;
    }

    location / {
        return 404;
    }
}
