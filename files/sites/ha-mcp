# Home Assistant MCP server (ha-mcp). Cloudflare Access authenticates callers
# with a service token before anything reaches here, and the client cert check
# below ensures requests can only arrive via Cloudflare. Only the MCP endpoint
# is proxied.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name  ha-mcp.itsshedtime.com;

    ssl_certificate /etc/letsencrypt/live/ha-mcp.itsshedtime.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ha-mcp.itsshedtime.com/privkey.pem;

    # Authenticated Origin Pulls, as for homeassistant
    ssl_client_certificate /etc/nginx/client-certs/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;

    location = /mcp {
        proxy_pass http://172.31.250.10:9584/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Keep the service token away from ha-mcp
        proxy_set_header X-HA-MCP-Access "";
        proxy_set_header CF-Access-Client-Id "";
        proxy_set_header CF-Access-Client-Secret "";
        # Streamable HTTP responds with server-sent events
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        return 404;
    }
}
