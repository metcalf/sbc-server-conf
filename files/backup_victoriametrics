#!/bin/bash
set -euxo pipefail

# Redirect output to syslog when not run in the terminal
if [ ! -t 1 ]; then
    exec 1> >(logger -t vm_backup) 2>&1
fi

if [ "$EUID" -ne 0 ]; then
    echo "run as root"
    exit 1
fi

VM_URL="http://127.0.0.1:8428"
DATA_PATH="/mnt/ExtData/victoriametrics"

# Rotate over a fixed set of slots so storage stays bounded (no per-day accumulation)
N_BACKUPS=15
# `10#` prefix is required to avoid a leading zero being interpreted as an octal number
BACKUP_NUMBER=$(( 10#$(date +%j) % N_BACKUPS ))
S3_DST="s3://itsshedtime-logs/victoriametrics_backup/victoriametrics_${BACKUP_NUMBER}.tgz"

# Always remove the snapshot and temp archive and report the status, even on
# failure. Installed before the snapshot is created so failures there are
# reported too; the guards cover the variables not being set yet.
snapshot_name=""
tgz_path=""
cleanup() {
    exit_code=$?
    if [ -n "$snapshot_name" ]; then
        curl -sSf "$VM_URL/snapshot/delete?snapshot=$snapshot_name" || true
    fi
    if [ -n "$tgz_path" ]; then
        rm -f "$tgz_path"
    fi
    /var/local/victoriametrics_backup_heartbeat /$exit_code
    exit $exit_code
}
trap cleanup EXIT

# Create a consistent snapshot and capture its name from the JSON response
snapshot_name=$(curl -sSf "$VM_URL/snapshot/create" | grep -o '"snapshot":"[^"]*"' | cut -d'"' -f4)
if [ -z "$snapshot_name" ]; then
    echo "failed to create snapshot" >&2
    exit 3
fi
snapshot_path="$DATA_PATH/snapshots/$snapshot_name"

# Archive the whole snapshot into a single gzipped tarball. Keep it on the data
# drive so we don't fill the root filesystem, and let the victoriametrics group
# (which loguploader is a member of) read it for the upload.
# -h/--dereference is required: a VictoriaMetrics snapshot's data/{small,big,indexdb}
# are symlinks into the per-table snapshot dirs, so without it tar only archives
# the symlinks and produces a near-empty tarball.
tgz_path=$(mktemp -p "$DATA_PATH" vmbackup.XXXXXX.tgz)
tar -czhf "$tgz_path" -C "$snapshot_path" .
chgrp victoriametrics "$tgz_path"
chmod 0640 "$tgz_path"

sudo -H -u loguploader /snap/bin/aws s3 cp "$tgz_path" "$S3_DST"
