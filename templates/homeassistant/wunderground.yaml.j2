{# Station observation fields exposed as attributes on each station sensor
   and on the merged most_recent_local_weather sensor. #}
{% set pws_attributes = ['epoch', 'humidity', 'uv', 'solarRadiation'] %}
template:
{% raw %}
  - sensor:
    # State-based template entities render `variables` once at setup and don't
    # track the entities they reference, so the station selection lives in its
    # own sensor instead.
    - name: "Most Recent Local PWS Station"
      default_entity_id: sensor.most_recent_local_weather_station
      unique_id: "most_recent_local_weather_station"
      state: >
        {% set ns = namespace(list=[]) %}
        {% for station in {% endraw %}{{ stations | tojson }}{% raw %} %}
          {% set e = 'sensor.weather_station_' ~ station | lower %}
          {% set ep = state_attr(e, 'epoch') %}
          {% if states(e) | is_number and ep is not none %}
            {% set ns.list = ns.list + [{'epoch': ep, 'entity': e}] %}
          {% endif %}
        {% endfor %}
        {{ (ns.list | sort(attribute='epoch') | last).entity if ns.list else none }}
    - name: "Most Recent Local PWS Weather"
      default_entity_id: sensor.most_recent_local_weather
      unique_id: "most_recent_local_weather"
      unit_of_measurement: °C
      device_class: temperature
      state_class: measurement
      availability: "{{ states(states('sensor.most_recent_local_weather_station')) | is_number }}"
      state: "{{ states(states('sensor.most_recent_local_weather_station')) }}"
      attributes:
{% endraw %}
{% for attr in pws_attributes %}
        {{ attr }}: "{{ '{{' }} state_attr(states('sensor.most_recent_local_weather_station'), '{{ attr }}') {{ '}}' }}"
{% endfor %}
{% raw %}
    - name: "Most Recent Local PWS Weather (°F)"
      default_entity_id: sensor.most_recent_local_weather_fahrenheit
      unique_id: "most_recent_local_weather_fahrenheit"
      unit_of_measurement: °F
      device_class: temperature
      state_class: measurement
      availability: "{{ states('sensor.most_recent_local_weather') | is_number }}"
      state: "{{ states('sensor.most_recent_local_weather') | float * 1.8 + 32 }}"
      attributes:
        epoch: "{{ state_attr('sensor.most_recent_local_weather', 'epoch') }}"
{% endraw %}

sensor:
{% for station in stations %}
  - platform: rest
    scan_interval: 300
    timeout: 8
    method: GET
    unit_of_measurement: °C
    value_template: {% raw %}"{{ value_json.observations[0].metric.temp }}"{% endraw +%}
    json_attributes_path: "$.observations[0]"
    json_attributes:
{% for attr in pws_attributes %}
      - {{ attr }}
{% endfor %}
    unique_id: "weather_{{ station }}"
    name: "Weather Station {{ station }}"
    resource: "https://api.weather.com/v2/pws/observations/current?apiKey=e1f10a1e78da46f5b10a1e78da96f525&numericPrecision=decimal&format=json&units=m&stationId={{ station }}"
{% endfor %}
